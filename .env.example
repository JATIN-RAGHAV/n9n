# Run make setup to generate .env with independent random secrets.
WEB_PORT=8080
# Local Docker database. Replace DATABASE_URL with your provider URL in production.
DATABASE_URL=postgres://n9n:n9n_local_dev@postgres:5432/n9n?sslmode=disable
POSTGRES_PASSWORD=n9n_local_dev
POSTGRES_PORT=55432
RUNNER_TOKEN=replace-with-random-token
ENCRYPTION_KEY=replace-with-64-hex-characters
COOKIE_SECURE=false
ALLOWED_ORIGIN=http://localhost:8080
RUNNER_ID=runner-1
RUNNER_POLL_MS=1000
RUNNER_CONCURRENCY=4
ALLOW_PRIVATE_HTTP=false
RUN_RETENTION_DAYS=30
# To enable Connect Gmail, create a Google OAuth web client with this redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/oauth/google/callback
