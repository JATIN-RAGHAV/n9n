{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "n9n",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  // node-postgres needs the Node.js APIs.
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },

  "routes": [{ "pattern": "n9n.walrus.codes", "custom_domain": true }],
  "workers_dev": false,

  // The Flutter web build is served from Cloudflare's edge as static assets.
  // Only API, health and runner paths reach the Worker script.
  "assets": {
    "directory": "../web/build/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz", "/internal/*"]
  },

  // PostgreSQL (Supabase) through Hyperdrive. Create the config with caching
  // disabled: the API must never read a cached session or run row.
  //   ./wrangler.sh hyperdrive create n9n-db --caching-disabled --connection-string=...
  // Local dev reads CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "19cbf94d50414094862923db8b5c3fc3" }],

  // 20 registration or login attempts per IP per minute, as in the Go API.
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "9091", "simple": { "limit": 20, "period": 60 } }],

  // Hourly cleanup of expired sessions, OAuth states and old finished runs.
  "triggers": { "crons": ["17 * * * *"] },

  "vars": {
    "COOKIE_SECURE": "true",
    "ALLOWED_ORIGIN": "https://n9n.walrus.codes",
    "RUN_RETENTION_DAYS": "30",
    "PASSWORD_PBKDF2_ITERATIONS": "100000",
    "GOOGLE_CLIENT_ID": "",
    "GOOGLE_REDIRECT_URI": "https://n9n.walrus.codes/api/oauth/google/callback"
  },
  // Set with `./wrangler.sh secret put <NAME>`; GOOGLE_CLIENT_SECRET is optional.
  "secrets": { "required": ["ENCRYPTION_KEY", "RUNNER_TOKEN"] }
}
